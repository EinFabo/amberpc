{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amber",
  "mainBinaryName": "amber",
  "version": "../package.json",
  "identifier": "app.amber.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EinFabo",
    "copyright": "© 2026 EinFabo",
    "category": "Productivity",
    "shortDescription": "Dictation into any window",
    "longDescription": "Amber turns speech into text and puts it where your cursor is - locally on your PC or through a server with your API key.",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/EinFabo/amberpc/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4QURDNTk0M0FBMUVCNzgKUldSNDY2RTZsTVd0Mk1DLzZ3aHZ6NUFYNDF1ZkFBanJpQzdlR3NjUlJWZDFtOXdqQ0QxYWFvYU0K",
      "windows": { "installMode": "passive" }
    }
  }
}
